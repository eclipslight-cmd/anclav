        // Adjust DKP Modal
        window.openAdjustModal = function(memberId) {
            const member = appState.members.find(m => m.id === memberId);
            if (!member) return;
            document.getElementById('adjustMemberId').value = member.id;
            document.getElementById('adjustModalTitle').innerText = `Изменить DKP для ${member.nick}`;
            document.getElementById('adjustAmount').value = '';
            document.getElementById('adjustReason').value = '';
            openModal('modalAdjust');
        }

        window.submitAdjustDKP = async function(e) {
            e.preventDefault();
            const memberId = document.getElementById('adjustMemberId').value;
            const type = document.getElementById('adjustType').value;
            const amount = parseInt(document.getElementById('adjustAmount').value);
            const reason = document.getElementById('adjustReason').value;

            const member = appState.members.find(m => m.id === memberId);
            if (!member) return;

            if (type === 'add') {
                member.dkp += amount;
                member.earned += amount;
                appState.audit.unshift({
                    id: 'a_' + Date.now(),
                    time: new Date().toLocaleString(),
                    type: 'Начисление',
                    member: member.nick,
                    amount: `+${amount}`,
                    reason: reason
                });
                showToast('Успешно', `Начислено ${amount} DKP бойцу ${member.nick}`);
            } else {
                if (member.dkp < amount) {
                    showToast('Ошибка', 'У бойца недостаточно DKP для списания!', true);
                    return;
                }
                member.dkp -= amount;
                member.spent += amount;
                appState.audit.unshift({
                    id: 'a_' + Date.now(),
                    time: new Date().toLocaleString(),
                    type: 'Списание',
                    member: member.nick,
                    amount: `-${amount}`,
                    reason: reason
                });
                showToast('Успешно', `Списано ${amount} DKP у бойца ${member.nick}`);
            }

            closeModal('modalAdjust');
            await window.saveStateToCloud();
            window.renderAll();
        }

