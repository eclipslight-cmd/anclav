            const filtered = appState.members.filter(m => {
                const matchesSearch = m.nick.toLowerCase().includes(searchTerm) || m.name.toLowerCase().includes(searchTerm) || m.className.toLowerCase().includes(searchTerm);
                const matchesClass = classFilter === '' || m.className === classFilter;
                return matchesSearch && matchesClass;
