<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anclav Clan | L2 DKP System (Cloud synced)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkbg: '#0a0b10',
                        cardbg: '#12141c',
                        cardhover: '#181b26',
                        gold: {
                            400: '#facc15',
                            500: '#eab308',
                            600: '#ca8a04',
                        },
                        crimson: {
                            500: '#ef4444',
                            600: '#dc2626',
                            700: '#b91c1c',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for Gaming Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a0b10;
            color: #e2e8f0;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0b10;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e2230;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #ca8a04;
        }
        .glow-gold {
            box-shadow: 0 0 20px rgba(234, 179, 8, 0.15);
        }
        .glow-crimson {
            box-shadow: 0 0 20px rgba(220, 38, 38, 0.2);
        }
        .fantasy-border {
            border: 1px solid rgba(234, 179, 8, 0.2);
        }
        .fantasy-border:hover {
            border-color: rgba(234, 179, 8, 0.5);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-darkbg text-slate-100">

    <!-- Notification Banner -->
    <div id="toast" class="fixed top-5 right-5 z-50 transform translate-x-full transition-transform duration-300 bg-slate-900 border border-amber-500 text-slate-100 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3">
        <i id="toast-icon" class="fa-solid fa-circle-check text-amber-400 text-xl"></i>
        <div>
            <h4 id="toast-title" class="font-bold text-sm">Успешно</h4>
            <p id="toast-msg" class="text-xs text-slate-400">Действие выполнено</p>
        </div>
    </div>

    <!-- Header / Navbar -->
    <header class="border-b border-amber-500/20 bg-cardbg/90 backdrop-blur sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo & Clan Name -->
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center glow-gold text-slate-950 font-black text-2xl border border-amber-300">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <span class="text-xs tracking-widest text-amber-400 font-semibold uppercase">Lineage 2 Clan</span>
                        <span id="sync-status" class="bg-emerald-500/10 text-emerald-400 text-[10px] px-2 py-0.5 rounded border border-emerald-500/30 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Облако: Синхронизировано
                        </span>
                    </div>
                    <h1 class="text-2xl font-black tracking-wider text-white uppercase flex items-center gap-2">
                        Anclav <span class="text-amber-500 font-light text-lg">DKP System</span>
                    </h1>
                </div>
            </div>

            <!-- Navigation Tabs & Controls -->
            <div class="flex items-center space-x-4">
                <nav class="hidden md:flex space-x-1 bg-slate-900/80 p-1.5 rounded-xl border border-slate-800">
                    <button onclick="switchTab('roster')" id="nav-roster" class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-amber-500 text-slate-950 shadow-md">
                        <i class="fa-solid fa-users mr-2"></i>Состав
                    </button>
                    <button onclick="switchTab('raids')" id="nav-raids" class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-400 hover:text-white hover:bg-slate-800">
                        <i class="fa-solid fa-dragon mr-2"></i>Рейды
                    </button>
                    <button onclick="switchTab('loot')" id="nav-loot" class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-400 hover:text-white hover:bg-slate-800">
                        <i class="fa-solid fa-gem mr-2"></i>Лут
                    </button>
                    <button onclick="switchTab('audit')" id="nav-audit" class="px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 text-slate-400 hover:text-white hover:bg-slate-800">
                        <i class="fa-solid fa-scroll mr-2"></i>Лог DKP
                    </button>
                </nav>

                <!-- Admin Mode Toggle -->
                <div class="flex items-center space-x-3 bg-slate-900 px-4 py-2 rounded-xl border border-amber-500/30">
                    <span class="text-xs text-slate-400 font-medium">Режим КЛа:</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="adminToggle" onchange="toggleAdminMode()" class="sr-only peer">
                        <div class="w-9 h-5 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-amber-500"></div>
                    </label>
                </div>
            </div>
        </div>
        <!-- Mobile Nav bar -->
        <div class="md:hidden flex overflow-x-auto space-x-2 p-2 bg-slate-900 border-t border-slate-800">
            <button onclick="switchTab('roster')" id="mob-nav-roster" class="flex-1 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium bg-amber-500 text-slate-950">Состав</button>
            <button onclick="switchTab('raids')" id="mob-nav-raids" class="flex-1 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-slate-800">Рейды</button>
            <button onclick="switchTab('loot')" id="mob-nav-loot" class="flex-1 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-slate-800">Лут</button>
            <button onclick="switchTab('audit')" id="mob-nav-audit" class="flex-1 whitespace-nowrap px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 bg-slate-800">Лог</button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- Dashboard Metrics Bar -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-cardbg rounded-2xl p-5 fantasy-border relative overflow-hidden group">
                <div class="absolute right-3 top-3 text-amber-500/10 text-6xl group-hover:text-amber-500/20 transition-all">
                    <i class="fa-solid fa-users"></i>
                </div>
                <p class="text-xs font-semibold text-amber-400 uppercase tracking-wider">Членов клана</p>
                <h3 id="stat-members" class="text-3xl font-black mt-2 text-white">0</h3>
                <p class="text-xs text-slate-400 mt-1">Активных игроков в ростере</p>
            </div>
            <div class="bg-cardbg rounded-2xl p-5 fantasy-border relative overflow-hidden group">
                <div class="absolute right-3 top-3 text-emerald-500/10 text-6xl group-hover:text-emerald-500/20 transition-all">
                    <i class="fa-solid fa-dragon"></i>
                </div>
                <p class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Рейд-Боссов убито</p>
                <h3 id="stat-raids" class="text-3xl font-black mt-2 text-white">0</h3>
                <p class="text-xs text-slate-400 mt-1">Эпических и клановых РБ</p>
            </div>
            <div class="bg-cardbg rounded-2xl p-5 fantasy-border relative overflow-hidden group">
                <div class="absolute right-3 top-3 text-amber-500/10 text-6xl group-hover:text-amber-500/20 transition-all">
                    <i class="fa-solid fa-coins"></i>
                </div>
                <p class="text-xs font-semibold text-amber-400 uppercase tracking-wider">Всего DKP на руках</p>
                <h3 id="stat-total-dkp" class="text-3xl font-black mt-2 text-white">0</h3>
                <p class="text-xs text-slate-400 mt-1">Суммарный баланс клана</p>
            </div>
            <div class="bg-cardbg rounded-2xl p-5 fantasy-border relative overflow-hidden group">
                <div class="absolute right-3 top-3 text-rose-500/10 text-6xl group-hover:text-rose-500/20 transition-all">
                    <i class="fa-solid fa-crown"></i>
                </div>
                <p class="text-xs font-semibold text-rose-400 uppercase tracking-wider">Топ по DKP</p>
                <h3 id="stat-top-earner" class="text-xl font-bold mt-3 text-white truncate">-</h3>
                <p id="stat-top-dkp" class="text-xs text-slate-400 mt-1">Самый активный боец</p>
            </div>
        </div>

        <!-- ================= TAB 1: ROSTER ================= -->
        <section id="tab-roster" class="space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-cardbg p-4 rounded-2xl fantasy-border">
                <div class="relative flex-1 w-full sm:max-w-md">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-slate-500"></i>
                    <input type="text" id="searchInput" oninput="filterRoster()" placeholder="Поиск по нику, имени или классу..." class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-11 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-all">
                </div>
                <div class="flex items-center space-x-3 w-full sm:w-auto justify-end">
                    <select id="classFilter" onchange="filterRoster()" class="bg-slate-900 border border-slate-700 text-slate-300 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-amber-500">
                        <option value="">Все классы</option>
                        <option value="Warcryer">Warcryer (WC)</option>
                        <option value="Cardinal">Cardinal (Bishop)</option>
                        <option value="Ghost Hunter">Ghost Hunter (PW)</option>
                        <option value="Adventurer">Adventurer (TH)</option>
                        <option value="Titan">Titan (Destro)</option>
                        <option value="Storm Screamer">Storm Screamer (SPS)</option>
                        <option value="Duelist">Duelist (Gladiator)</option>
                        <option value="Moonlight Sentinel">Moonlight Sentinel (SR)</option>
                        <option value="Eva's Saint">Eva's Saint (EE)</option>
                        <option value="Grand Khavatari">Grand Khavatari (Tyrant)</option>
                    </select>
                    <!-- Admin Action Button -->
                    <button id="addMemberBtn" onclick="openAddMemberModal()" class="hidden bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 font-bold px-4 py-2.5 rounded-xl text-sm transition-all shadow-lg flex items-center space-x-2">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>Добавить бойца</span>
                    </button>
                </div>
            </div>

            <!-- Members Table -->
            <div class="bg-cardbg rounded-2xl fantasy-border overflow-hidden shadow-2xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-800 bg-slate-900/60 text-xs uppercase tracking-wider text-amber-400 font-semibold">
                                <th class="py-4 px-6">Ник / Имя</th>
                                <th class="py-4 px-6">Класс</th>
                                <th class="py-4 px-6 text-center">Текущий DKP</th>
                                <th class="py-4 px-6 text-center">Заработано</th>
                                <th class="py-4 px-6 text-center">Потрачено</th>
                                <th class="py-4 px-6 text-right admin-col hidden">Управление DKP</th>
                            </tr>
                        </thead>
                        <tbody id="rosterTableBody" class="divide-y divide-slate-800/60 text-sm">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= TAB 2: RAIDS ================= -->
        <section id="tab-raids" class="space-y-6 hidden">
            <div class="flex justify-between items-center bg-cardbg p-4 rounded-2xl fantasy-border">
                <div>
                    <h2 class="text-xl font-bold text-white">История рейдов и эвентов</h2>
                    <p class="text-xs text-slate-400">Участие в эпических боссах и начисление DKP клану</p>
                </div>
                <button id="addRaidBtn" onclick="openAddRaidModal()" class="hidden bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 font-bold px-4 py-2.5 rounded-xl text-sm transition-all shadow-lg flex items-center space-x-2">
                    <i class="fa-solid fa-plus"></i>
                    <span>Залогировать рейд</span>
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="raidsGrid">
                <!-- Populated via JS -->
            </div>
        </section>

        <!-- ================= TAB 3: LOOT ================= -->
        <section id="tab-loot" class="space-y-6 hidden">
            <div class="flex justify-between items-center bg-cardbg p-4 rounded-2xl fantasy-border">
                <div>
                    <h2 class="text-xl font-bold text-white">Распределение лута (Эпик / S-Grade)</h2>
                    <p class="text-xs text-slate-400">История выдачи ценных предметов за DKP</p>
                </div>
                <button id="addLootBtn" onclick="openAddLootModal()" class="hidden bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 font-bold px-4 py-2.5 rounded-xl text-sm transition-all shadow-lg flex items-center space-x-2">
                    <i class="fa-solid fa-gem"></i>
                    <span>Выдать лут</span>
                </button>
            </div>

            <div class="bg-cardbg rounded-2xl fantasy-border overflow-hidden shadow-2xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-800 bg-slate-900/60 text-xs uppercase tracking-wider text-amber-400 font-semibold">
                                <th class="py-4 px-6">Дата</th>
                                <th class="py-4 px-6">Предмет</th>
                                <th class="py-4 px-6">Получатель</th>
                                <th class="py-4 px-6 text-center">Стоимость DKP</th>
                                <th class="py-4 px-6">Рейд / Событие</th>
                            </tr>
                        </thead>
                        <tbody id="lootTableBody" class="divide-y divide-slate-800/60 text-sm">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= TAB 4: AUDIT LOG ================= -->
        <section id="tab-audit" class="space-y-6 hidden">
            <div class="bg-cardbg p-4 rounded-2xl fantasy-border">
                <h2 class="text-xl font-bold text-white">Аудит-лог DKP операций</h2>
                <p class="text-xs text-slate-400">Хронологический список всех начислений и списаний в клане</p>
            </div>

            <div class="bg-cardbg rounded-2xl fantasy-border overflow-hidden shadow-2xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-800 bg-slate-900/60 text-xs uppercase tracking-wider text-amber-400 font-semibold">
                                <th class="py-4 px-6">Время</th>
                                <th class="py-4 px-6">Тип</th>
                                <th class="py-4 px-6">Боец</th>
                                <th class="py-4 px-6">Сумма</th>
                                <th class="py-4 px-6">Причина / Описание</th>
                            </tr>
                        </thead>
                        <tbody id="auditTableBody" class="divide-y divide-slate-800/60 text-sm">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 bg-cardbg mt-12 py-6 text-center text-xs text-slate-500">
        <p>Anclav Clan Portal © 2026. Cloud synced via Firebase. Lineage 2 High Five DKP Tracker.</p>
    </footer>

    <!-- ================= MODALS ================= -->

    <!-- Modal: Adjust DKP -->
    <div id="modalAdjust" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
        <div class="bg-cardbg border border-amber-500/40 rounded-2xl w-full max-w-md p-6 space-y-6 shadow-2xl relative">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-bold text-white" id="adjustModalTitle">Изменить DKP</h3>
                <button onclick="closeModal('modalAdjust')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form id="adjustForm" onsubmit="submitAdjustDKP(event)" class="space-y-4">
                <input type="hidden" id="adjustMemberId">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Действие</label>
                    <select id="adjustType" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                        <option value="add">Начислить DKP (+)</option>
                        <option value="deduct">Списать DKP (-)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Количество DKP</label>
                    <input type="number" id="adjustAmount" required min="1" max="10000" placeholder="Например: 50" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Причина / Событие</label>
                    <input type="text" id="adjustReason" required placeholder="Например: Убийство Баюма / Штраф за опоздание" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeModal('modalAdjust')" class="px-4 py-2 rounded-xl text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all">Отмена</button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-sm font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition-all">Подтвердить</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Add Member -->
    <div id="modalAddMember" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
        <div class="bg-cardbg border border-amber-500/40 rounded-2xl w-full max-w-md p-6 space-y-6 shadow-2xl relative">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">Добавить нового бойца</h3>
                <button onclick="closeModal('modalAddMember')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form onsubmit="submitAddMember(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Никнейм в игре</label>
                    <input type="text" id="newMemberNick" required placeholder="Например: ShadowBlade" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Имя игрока</label>
                    <input type="text" id="newMemberName" required placeholder="Например: Алексей" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Класс</label>
                    <select id="newMemberClass" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                        <option value="Warcryer">Warcryer (WC)</option>
                        <option value="Cardinal">Cardinal (Bishop)</option>
                        <option value="Ghost Hunter">Ghost Hunter (PW)</option>
                        <option value="Adventurer">Adventurer (TH)</option>
                        <option value="Titan">Titan (Destro)</option>
                        <option value="Storm Screamer">Storm Screamer (SPS)</option>
                        <option value="Duelist">Duelist (Gladiator)</option>
                        <option value="Moonlight Sentinel">Moonlight Sentinel (SR)</option>
                        <option value="Eva's Saint">Eva's Saint (EE)</option>
                        <option value="Grand Khavatari">Grand Khavatari (Tyrant)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Стартовый DKP</label>
                    <input type="number" id="newMemberDkp" value="0" min="0" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeModal('modalAddMember')" class="px-4 py-2 rounded-xl text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all">Отмена</button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-sm font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition-all">Добавить</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Add Raid -->
    <div id="modalAddRaid" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
        <div class="bg-cardbg border border-amber-500/40 rounded-2xl w-full max-w-md p-6 space-y-6 shadow-2xl relative">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">Залогировать новый рейд</h3>
                <button onclick="closeModal('modalAddRaid')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form onsubmit="submitAddRaid(event)" class="space-y-4">
                <div>
