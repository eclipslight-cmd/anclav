        window.openAddMemberModal = function() {
            document.getElementById('newMemberNick').value = '';
            document.getElementById('newMemberName').value = '';
            document.getElementById('newMemberDkp').value = '0';
            openModal('modalAddMember');
        }

        window.submitAddMember = async function(e) {
            e.preventDefault();
            const nick = document.getElementById('newMemberNick').value;
            const name = document.getElementById('newMemberName').value;
            const className = document.getElementById('newMemberClass').value;
            const dkp = parseInt(document.getElementById('newMemberDkp').value) || 0;

            const newMember = {
                id: 'm_' + Date.now(),
                nick: nick,
                name: name,
                className: className,
                dkp: dkp,
                earned: dkp,
                spent: 0
            };

            appState.members.push(newMember);
            appState.audit.unshift({
                id: 'a_' + Date.now(),
                time: new Date().toLocaleString(),
                type: 'Состав',
                member: nick,
                amount: `+${dkp}`,
                reason: 'Вступление в клан Anclav'
            });

            closeModal('modalAddMember');
            showToast('Боец добавлен', `${nick} (${className}) успешно зачислен в состав`);
            await window.saveStateToCloud();
            window.renderAll();
        }

        // Add Raid Modal
        window.openAddRaidModal = function() {
            document.getElementById('raidBossName').value = '';
            document.getElementById('raidDkpReward').value = '150';
            document.getElementById('raidDate').value = new Date().toISOString().split('T')[0];
            document.getElementById('raidDesc').value = '';
            openModal('modalAddRaid');
        }

        window.submitAddRaid = async function(e) {
            e.preventDefault();
            const boss = document.getElementById('raidBossName').value;
            const reward = parseInt(document.getElementById('raidDkpReward').value);
            const date = document.getElementById('raidDate').value;
            const desc = document.getElementById('raidDesc').value || 'Победный рейд клана';

            const newRaid = {
                id: 'r_' + Date.now(),
                boss: boss,
                reward: reward,
                date: date,
                desc: desc
            };

            appState.raids.unshift(newRaid);

            // Give DKP to all existing members
            appState.members.forEach(m => {
                m.dkp += reward;
                m.earned += reward;
            });

            appState.audit.unshift({
                id: 'a_' + Date.now(),
                time: `${date} (Рейд)`,
                type: 'Рейд',
                member: 'Все кланабельные',
                amount: `+${reward}`,
                reason: `Убийство ${boss}`
            });

            closeModal('modalAddRaid');
            showToast('Рейд залогирован', `Всем бойцам начислено по +${reward} DKP за ${boss}`);
            await window.saveStateToCloud();
            window.renderAll();
        }

        // Add Loot Modal
        window.openAddLootModal = function() {
            document.getElementById('lootItemName').value = '';
            document.getElementById('lootDkpCost').value = '';
            document.getElementById('lootRaidSource').value = '';

            const select = document.getElementById('lootMemberSelect');
            select.innerHTML = '';
            appState.members.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m.nick;
                opt.innerText = `${m.nick} (${m.className} - ${m.dkp} DKP)`;
                select.appendChild(opt);
            });

            openModal('modalAddLoot');
        }

        window.submitAddLoot = async function(e) {
            e.preventDefault();
            const item = document.getElementById('lootItemName').value;
            const memberNick = document.getElementById('lootMemberSelect').value;
            const cost = parseInt(document.getElementById('lootDkpCost').value);
            const raid = document.getElementById('lootRaidSource').value;

            const member = appState.members.find(m => m.nick === memberNick);
            if (!member) return;

            if (member.dkp < cost) {
                showToast('Ошибка', `У бойца ${member.nick} недостаточно DKP (${member.dkp}) для выдачи лута стоимостью ${cost}!`, true);
                return;
            }

            member.dkp -= cost;
            member.spent += cost;

            const todayFormatted = new Date().toLocaleDateString();
            appState.loot.unshift({
                id: 'l_' + Date.now(),
                date: todayFormatted,
                item: item,
                member: member.nick,
                cost: cost,
                raid: raid
            });

            appState.audit.unshift({
                id: 'a_' + Date.now(),
                time: new Date().toLocaleString(),
                type: 'Лут',
                member: member.nick,
                amount: `-${cost}`,
                reason: `Выдача ${item} (${raid})`
            });

            closeModal('modalAddLoot');
            showToast('Лут выдан', `Предмет ${item} передан ${member.nick} за ${cost} DKP`);
            await window.saveStateToCloud();
            window.renderAll();
        }
    </script>
</body>
</html>
