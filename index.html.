                { id: 'a2', time: '01.03.2026 22:05', type: 'Лут', member: 'Риня', amount: '-350', reason: 'Выдача Ring of Queen Ant' },
                { id: 'a3', time: '24.02.2026 23:15', type: 'Рейд', member: 'Все кланабельные', amount: '+300', reason: 'Убийство Baium' },
                { id: 'a4', time: '24.02.2026 23:50', type: 'Лут', member: 'Андрей', amount: '-600', reason: "Выдача Baium's Ring" }
            ]
        };

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'anclav-dkp-default';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;

        let db, auth, clanStateDocRef;

        window.saveStateToCloud = async function() {
            if (!db || !clanStateDocRef) return;
            try {
                // Save complete state to Firestore (Rule 1 path)
                await setDoc(clanStateDocRef, {
                    members: window.appState.members,
                    raids: window.appState.raids,
                    loot: window.appState.loot,
                    audit: window.appState.audit,
                    updatedAt: new Date().toISOString()
                });
            } catch (err) {
                console.error("Error saving to cloud:", err);
                showToast("Ошибка сохранения", "Не удалось синхронизировать с облаком", true);
            }
        };

        async function initFirebase() {
            if (!firebaseConfig) {
                console.warn("Firebase config not found. Running in offline mode.");
                document.getElementById('sync-status').innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span> Оффлайн режим';
                window.renderAll();
                return;
            }

            try {
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                // Rule 3: Auth before operations
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                // Rule 1: Strict public path for shared clan data
                clanStateDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'clan_state');

                // Real-time listener using onSnapshot with error callback
                onSnapshot(clanStateDocRef, (docSnap) => {
                    if (docSnap.exists()) {
                        const data = docSnap.data();
                        if (data.members) window.appState.members = data.members;
                        if (data.raids) window.appState.raids = data.raids;
                        if (data.loot) window.appState.loot = data.loot;
                        if (data.audit) window.appState.audit = data.audit;
                        window.renderAll();
                    } else {
                        // Initialize document if it doesn't exist yet
                        window.saveStateToCloud();
                    }
                }, (error) => {
                    console.error("Firestore sync error:", error);
                    document.getElementById('sync-status').innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-500"></span> Ошибка связи';
                });

            } catch (e) {
                console.error("Failed to initialize Firebase:", e);
                window.renderAll();
            }
        }

        initFirebase();
    </script>

    <!-- Application UI Logic -->
